# Choose one provider. .env is not loaded automatically.
# Export settings in your terminal, or source a private, uncommitted .env.
# Auto-detection: TypeSafe, Vercel, Cloudflare, then offline mock.

# Option A: official TypeSafe API
# TYPESAFE_API_KEY=your_typesafe_key_here

# Option B: Jev on Cloudflare Workers AI (model typesafe/jev)
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# CLOUDFLARE_API_TOKEN=your_workers_ai_token

# Option C: Vercel AI Gateway, using the TypeSafe-compatible API
# AI_GATEWAY_API_KEY=your_vercel_gateway_key_here
# FASTGATE_BACKEND=vercel

# Optional explicit model override. If Vercel reports a model error, try typesafe-ai/jev.
# TYPESAFE_MODEL=jev-latest

# Optional LangChain model for answers and the baseline comparison
# FASTGATE_LLM=anthropic:claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Routing thresholds (tune on separate development data)
FASTGATE_AUTO_CONF=0.85
FASTGATE_PASSAGE_KEEP=0.5
