# Copy to .env (never commit .env) and export before running
TYPESAFE_API_KEY=your_typesafe_key_here
TYPESAFE_MODEL=jev-latest
# Optional LLM for answers and the baseline comparison (LangChain model id)
FASTGATE_LLM=anthropic:claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=your_anthropic_key_here
# Routing thresholds (tune from benchmark output)
FASTGATE_AUTO_CONF=0.85
FASTGATE_PASSAGE_KEEP=0.5
